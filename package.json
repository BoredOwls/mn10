{
  "name": "mn10",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "rebuild": "docker compose -f docker-compose.yaml build --no-cache && docker compose -f docker-compose.yaml up -d",
    "up": "docker compose -f docker-compose.yaml up -d",
    "down": "docker compose -f docker-compose.yaml down",
    "server": "cd apps/server && npm run dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
