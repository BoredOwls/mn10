DATABASE_URL=postgres://postgres:password@localhost:5432/mn10
NODE_ENV="development"

#if debug mode, show verbose error logs (dev mode)
DEBUG_MODE=1

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Base URL of this server (used as OAuth callback base)
BASE_URL=http://localhost:8080

# Where to redirect after successful login
AFTER_AUTH_REDIRECT_URL=http://localhost:5173
